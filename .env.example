# Copy to .env.local for local dev (vercel dev) and set the real values in
# Vercel > Project Settings > Environment Variables. Never commit real values.

# ---- Studio (/edit) ----

# Danique's studio password. Choose a new, long one (a few random words is
# fine). Changing it does not log out devices that are already logged in;
# change SESSION_SECRET for that.
STUDIO_PASSWORD=

# Signs the studio login cookie. Random, at least 32 characters, e.g.
#   openssl rand -hex 32
# Changing it logs out every device.
SESSION_SECRET=

# ---- Storage ----

# Upstash Redis (site content, login rate limit, Instagram cache and token).
# Added automatically when you install the Upstash Redis integration from the
# Vercel Marketplace and connect it to this project; no need to set by hand.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Vercel Blob (photos Danique uploads in the studio). Added automatically when
# you create a Blob store under Storage and connect it to this project.
# BLOB_READ_WRITE_TOKEN=

# ---- Instagram feed ----

# One-time bootstrap only: paste the LONG-LIVED Instagram token here (exchanged
# from a fresh short-lived token via graph.instagram.com/access_token?grant_type=ig_exchange_token).
# After the first successful cron run, the refreshed token lives in Redis
# instead, so this var can be removed once that's confirmed working.
IG_INITIAL_TOKEN=

# Shared secret so only Vercel Cron (not the public internet) can trigger the
# refresh endpoint. Generate any random string and set the same value here
# and in Project Settings > Environment Variables on Vercel.
CRON_SECRET=

# ---- Commission form, "Send by email" ----

# Resend (resend.com) API key. The domain atelierdanique.com must be verified
# in Resend (DNS records at Namecheap) before emails can be sent from it.
RESEND_API_KEY=

# Optional. Where requests go (default hello@atelierdanique.com) and the
# sender shown (default "Atelier Danique website <website@atelierdanique.com>").
# COMMISSION_TO=
# COMMISSION_FROM=
